{
  "name": "ptitsocial",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "start:accounts": "npm run start --workspace @ptitsocial/accounts",
    "start:content": "npm run start --workspace @ptitsocial/content",
    "start:messaging": "npm run start --workspace @ptitsocial/messaging",
    "start:gateway": "npm run start --workspace @ptitsocial/gateway",
    "start:web": "npm --prefix apps/web start",
    "build:web": "npm --prefix apps/web run build",
    "migrate:legacy": "node scripts/migrate-legacy.cjs",
    "check:migration": "node scripts/check-migration.cjs",
    "test:architecture": "node --test tests/architecture.test.cjs",
    "test:integration": "node tests/integration.cjs",
    "format": "prettier --write services packages scripts tests apps/web/src",
    "start:learning": "npm run start --workspace @ptitsocial/learning",
    "test:learning": "node --test tests/learning.test.cjs tests/roadmap-sources.test.cjs tests/gemini-key-pool.test.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.32.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "fcm-node": "^1.6.1",
    "html-to-text": "^8.2.1",
    "jsonwebtoken": "^8.5.1",
    "mongodb": "^4.12.1",
    "mongoose": "^6.7.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.8.0",
    "nodemon": "^2.0.20",
    "pug": "^3.0.2",
    "sharp": "^0.31.2",
    "socket.io": "^4.5.4",
    "unique-username-generator": "^1.1.3",
    "validator": "^13.7.0",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
